# API only. Copy to .env.api, never include migration/bootstrap/admin credentials here.
NODE_ENV=development
PORT=3000
# Reverse-proxy hops in front of the API (0 = direct). Rate limits key on the resulting client IP.
TRUST_PROXY=0
LOG_LEVEL=warn
APP_ORIGIN=http://localhost:3000
AUTH_METHODS=local
PRODUCT_DATA_DATABASE_URL=postgres://product_data:REPLACE@127.0.0.1:5432/product_authz
PRODUCT_IDENTITY_DATABASE_URL=postgres://product_identity:REPLACE@127.0.0.1:5432/product_authz
PRODUCT_AUTHORITY_DATABASE_URL=postgres://product_authority:REPLACE@127.0.0.1:5432/product_authz
PRODUCT_SYNC_DATABASE_URL=postgres://product_sync:REPLACE@127.0.0.1:5432/product_authz
# Required only for AUTH_METHODS=oidc or local,oidc. Fixed HTTPS callbacks; no email/group mapping.
# OIDC_PROVIDERS_JSON=[{"issuer":"https://idp.example.test","clientId":"product","redirectUri":"https://app.example.test/auth/oidc/callback","version":"1","assuranceMappings":[]}]
